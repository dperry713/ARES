# ARES deployment environment sample.
#
# Copy to a file named ".env" next to docker-compose.yml, fill in the secret,
# and never commit the copy. Generate a credential with:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# or any 32+ byte random string.
#
# Replace the bootstrap key with statically configured Ares__Auth__Keys__*
# entries once per-service keys exist; the bootstrap key is a first-boot
# device only and is not persisted by the platform.

ARES_BOOTSTRAP_ADMIN_KEY=change-me-before-running

# Optional
ARES_VERSION=1.0.0
ARES_RATE_LIMIT_PER_MINUTE=240
# Mixed into stored API-key hashes. Rotating it invalidates every stored hash.
# ARES_AUTH_PEPPER=
