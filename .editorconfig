root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md,props,targets,csproj,slnx}]
indent_size = 2

[*.ps1]
indent_size = 4
end_of_line = crlf

[*.{cs,csx}]
indent_size = 4
dotnet_sort_system_directives_first = true

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
dotnet_diagnostic.CA2007.severity = none   # library ConfigureAwait is opt-in here
dotnet_diagnostic.CA1848.severity = none   # LoggerMessage source-gen not required
